{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "harmony", "src-reference"],
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "noUnusedLocals": true,
    "baseUrl": "./src",
    "verbatimModuleSyntax": true,
    "paths": {
      "react-native-fs": ["../node_modules/@react-native-ohos/react-native-fs"],
      "@react-native-async-storage/async-storage": [
        "../node_modules/@react-native-ohos/async-storage"
      ],
      "@react-native-cookies/cookies": [
        "../node_modules/@react-native-ohos/cookies"
      ],
      "react-native-blob-util": [
        "../node_modules/@react-native-ohos/react-native-blob-util"
      ],
      "react-native-gesture-handler": [
        "../node_modules/@react-native-ohos/react-native-gesture-handler"
      ],
      "react-native-webview": [
        "../node_modules/@react-native-ohos/react-native-webview"
      ],
      "@react-navigation/elements": [
        "../node_modules/@react-native-ohos/elements"
      ],
      "@react-navigation/native-stack": [
        "../node_modules/@react-native-ohos/native-stack"
      ],
      "react-native-safe-area-context": [
        "../node_modules/@react-native-ohos/react-native-safe-area-context"
      ],
      "@react-navigation/stack": ["../node_modules/@react-native-ohos/stack"],
      "react-native-localize": [
        "../node_modules/@react-native-ohos/react-native-localize"
      ],
      "react-native-pager-view": [
        "../node_modules/@react-native-ohos/react-native-pager-view"
      ],
      "react-native-pdf": [
        "../node_modules/@react-native-ohos/react-native-pdf"
      ],
      "react-native-reanimated": [
        "../node_modules/@react-native-ohos/react-native-reanimated"
      ],
      "react-native-share": [
        "../node_modules/@react-native-ohos/react-native-share"
      ],
      "react-native-tab-view": [
        "../node_modules/@react-native-ohos/react-native-tab-view"
      ],
      "react-native-secure-key-store": [
        "../node_modules/@react-native-ohos/react-native-secure-key-store"
      ],
      "react-native-file-viewer": [
        "../node_modules/@react-native-ohos/react-native-file-viewer"
      ],
      "react-native-document-picker": [
        "../node_modules/@react-native-ohos/react-native-document-picker"
      ],
      "react-native-image-picker": [
        "../node_modules/@react-native-ohos/react-native-image-picker"
      ],
      "react-native-device-info": [
        "../node_modules/@react-native-ohos/react-native-device-info"
      ],
      "react-native-screens": [
        "../node_modules/@react-native-ohos/react-native-screens"
      ]
    }
  }
}
