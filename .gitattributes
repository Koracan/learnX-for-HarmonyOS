# i18n 生成物由 scripts/generate-i18n-resources.mjs 按 LF 写出。
# 本机 core.autocrlf=true（仓库无 .gitattributes）会把 checkout 落成 CRLF，
# 于是 scripts/check-generated-fresh.mjs 的「跑前 / 跑后哈希」必然不等 ——
# 实测：**在全新 worktree / 全新 checkout 里第一次跑必假红**，重跑一次才 PASS。
# 把这 6 个路径固定成 LF，让工作区与生成器输出一致（本机实测：加之前首次必红，加之后稳定绿）。
entry/src/main/resources/base/element/string.json text eol=lf
entry/src/main/resources/zh_CN/element/string.json text eol=lf
entry/src/main/resources/en_US/element/string.json text eol=lf
entry/src/main/ets/core/i18n/I18nKeys.ets text eol=lf
.scratch/foundation/i18n-keys.json text eol=lf
.scratch/foundation/i18n-key-map.md text eol=lf
