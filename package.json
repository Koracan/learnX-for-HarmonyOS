{
  "name": "learn-oh",
  "version": "1.1.0",
  "private": true,
  "lint-staged": {
    "*.{js,ts,json}": [
      "prettier --write",
      "git add"
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "release": "pwsh scripts/build_release.ps1",
    "patch:ohos-deps": "pwsh scripts/patch_harmony_oh_modules.ps1",
    "codegen": "react-native codegen-harmony --cpp-output-path ./harmony/entry/src/main/cpp/generated --rnoh-module-path ./harmony/entry/oh_modules/@rnoh/react-native-openharmony",
    "postinstall": "node scripts/sync-harmony-aliases.js",
    "prepare": "husky"
  },
